VITE_CONVEX_URL=https://YOUR-DEV-DEPLOYMENT.convex.cloud
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# Do NOT put CONVEX_DEPLOY_KEY in a committed file.
# Deadline email settings belong in Convex Dashboard, NOT Vite/Vercel frontend variables:
# DEADLINE_EMAIL_ENABLED=false (set true only after SMTP setup and recipient opt-in)
# EMAIL_APP_URL=https://your-application.example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-sender@gmail.com
# SMTP_PASS=<Gmail App Password; set privately in Convex, never commit>
# SMTP_FROM defaults to SMTP_USER. Optional: a verified sender email address.
